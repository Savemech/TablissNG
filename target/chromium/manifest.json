{
  "manifest_version": 3,
  "name": "Fdial",
  "version": "PLACEHOLDER",
  "description": "A fast, private new-tab dashboard with Speed Dial, Agenda, daypart backgrounds and portable backups.",
  "homepage_url": "https://github.com/Savemech/TablissNG",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "search",
    "identity",
    "alarms"
  ],
  "optional_permissions": [
    "bookmarks",
    "topSites"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
