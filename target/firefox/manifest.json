{
  "manifest_version": 2,
  "name": "Fdial",
  "version": "PLACEHOLDER",
  "description": "A fast, private new-tab dashboard with Speed Dial, Agenda, daypart backgrounds and portable backups.",
  "homepage_url": "https://github.com/Savemech/TablissNG",
  "browser_specific_settings": {
    "gecko": {
      "id": "fdial@savemech.github",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "authenticationInfo",
          "bookmarksInfo",
          "locationInfo",
          "searchTerms"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "chrome_settings_overrides": {
    "homepage": "index.html"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "search",
    "identity",
    "alarms"
  ],
  "optional_permissions": [
    "bookmarks",
    "topSites",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  }
}
